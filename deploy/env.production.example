# 生产环境配置样例 —— 复制到 backend/.env 后逐项填写
# ⚠️ 本文件不入库真实密钥；所有标注「必填」的项不能留默认值

# ---- 安全（必填）----
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<换成 48+ 位随机串>

# 允许的前端来源（你的子域名；逗号分隔，不要带末尾斜杠）
CORS_ORIGINS=https://zhitu.zhengyun.online

# 超管初始密码（首登后立即在系统里改掉）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<强密码>
ADMIN_EMAIL=<你的邮箱>

# ---- 数据库与向量库 ----
# SQLite 默认即可（小团队足够）；库文件在 backend/hr_ai.db
DATABASE_URL=sqlite:///./hr_ai.db
# ⚠️ Linux 上 Qdrant 地址不要写 localhost（可能解析成 IPv6），写 127.0.0.1
QDRANT_URL=http://127.0.0.1:6333

# ---- LLM / Embedding（按你实际用的服务商填）----
DEFAULT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_API_KEY=<必填>
DEFAULT_LLM_MODEL=qwen-plus
DEFAULT_EMBEDDING_API_KEY=<必填>
DEFAULT_EMBEDDING_MODEL=text-embedding-v3

# ---- SMTP（忘记密码用；单人使用可先留空，功能会静默跳过）----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Agent 灰度（生产建议先 off，观察后再开 shadow）----
AGENT_MODE=off
AGENT_SHADOW_RATE=0.2

# ---- 文档确认免登录通道（默认关；需要给学校老师用再开）----
DOC_CONFIRM_PUBLIC_ENABLED=false
DOC_CONFIRM_TOKEN_TTL_DAYS=7
