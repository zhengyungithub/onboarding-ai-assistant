# 环境变量配置模板 - 复制为 .env 并填入真实值

# 数据库
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_ai

# Qdrant 向量库
QDRANT_URL=http://localhost:6333

# JWT 密钥（生产环境请更换为随机字符串）
JWT_SECRET_KEY=please-change-this-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Key 加密密钥（Fernet，32位urlsafe base64）
# 生成方式: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=please-generate-a-fernet-key

# 管理员初始化账号（首次启动时创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login
ADMIN_EMAIL=admin@example.com

# 默认 LLM 配置（管理员兜底用，用户未配置时使用）
DEFAULT_LLM_BASE_URL=https://api.deepseek.com
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=deepseek-chat
DEFAULT_EMBEDDING_API_KEY=
DEFAULT_EMBEDDING_MODEL=bge-small-zh-v1.5

# 邮件 SMTP 配置（用于忘记密码验证码）
# QQ邮箱: smtp.qq.com:465, 需在邮箱设置中开启 SMTP 并获取授权码
# 163邮箱: smtp.163.com:465
# 企业邮箱: 请咨询企业 IT
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your_email@qq.com
SMTP_PASSWORD=your_email_auth_code
SMTP_FROM=your_email@qq.com

# ==================== 文档确认清单 ====================
# 免登录确认通道（默认关闭）。开启后发起确认可生成专属链接给没有账号的同事。
DOC_CONFIRM_PUBLIC_ENABLED=false
DOC_CONFIRM_TOKEN_TTL_DAYS=7
